rownames(coef_summary8) <- c("Information \n(n = 53)","Label \n(n = 126)","Loan \n(n = 9)","Rebate \n(n = 27)","Subsidy \n(n = 27)")
knitr::opts_chunk$set(echo = TRUE)
coef_summary6_1 <- coef(summary(meta_model6_1))[-10,]
rownames(coef_summary6_1) <- c("Air-Conditioner \n(n = 34)","Clothes Dryer \n(n = 19)","Dishwasher \n(n = 4)","Heat Pump \n(n = 18)","Lighting \n(n = 34)","Refrigerator \n(n = 60)","TV \n(n = 12)","Washing Machine \n(n = 18)","Water Heater \n(n = 43)")
knitr::opts_chunk$set(echo = TRUE)
ggplot(coef_summary6_1,
aes(x = row.names(coef_summary6_1), y = estimate)) +
geom_linerange(aes(ymin = ci.lb, ymax = ci.ub),
size = 1.5, alpha = 1, colour = "red")  +
geom_point(size = 3) +
geom_hline(yintercept = average_estimate5_1, linetype = "dashed", color = "black", size = .5) +
geom_hline(yintercept = 0, color = "gray", size = .5)+
annotate("text", x = 6, y = average_estimate5_1 - 0.025, label = paste("Average:", round(average_estimate5_1, 2)), size = 4.5, vjust=1) +
# scale_y_continuous(limits = c(-0.15, 0.35)) +
labs(x = "", y = "z-value") +
ylim(-.4, 0.4)+
theme_bw() +
theme(text = element_text(size = 16)) + theme(axis.text.x = element_text(angle = 45, vjust = 1, hjust=1))
ggsave("revisedint_appliances_forest_6_1_avME_1.png", height=6, width=9)
knitr::opts_chunk$set(echo = TRUE)
