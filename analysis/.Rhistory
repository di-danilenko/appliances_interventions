data_purchase <- data.frame()
# exclude outliers
appliances <- appliances %>%
filter(!(study_ID %in% c('117','122')))
# 117 exclude Houde & Aldy (2014) as a pre-print of Houde & Aldy (2017)
# 122 exclude Caroll et al. (2016) as there is no control (comparison of 2 different label configurations)
# include WTP and purchase probability together
data_purchase <- appliances %>%
filter(dep_variable_purchase_category %in% c("purschase (probability) of efficient appliance", "WTP for efficient appliance"))
data_purchase <- data_purchase %>%
filter(!intervention == "Command & Control")
data_purchase <- data_purchase %>%
filter(!appliance == "NA")
data_purchase$subsidy <- case_when(
data_purchase$tax_credit == 1 ~ 1,
TRUE ~ data_purchase$subsidy)
data_purchase$information <- case_when(
data_purchase$feedback == 1 ~ 1,
TRUE ~ data_purchase$information)
data_purchase$information <- case_when(
data_purchase$information == 1 & data_purchase$label == 1 ~ 0,
TRUE ~ data_purchase$information)
table(data_purchase$appliance)
table(data_purchase$intervention)
print(length(unique(data_purchase$study_ID)))
### FIXED EFFECTS ###
meta_model1 <- rma(z_value, z_variance, data = data_purchase, method = "FE", mods = ~ information+label+loan+rebate+subsidy+0)
summary(meta_model1)
meta_model2 <- rma(z_value, z_variance, data = data_purchase, method = "FE", mods = ~ appliance+0)
summary(meta_model2)
### RANDOM EFFECTS ###
meta_model3 <- rma(z_value, z_variance, data = data_purchase, method = "REML", mods = ~ information+label+loan+rebate+subsidy+0)
