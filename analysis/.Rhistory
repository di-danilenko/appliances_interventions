### PUBLICATION BIAS ASSESSMENT ###
library(lmtest)
### EGGERS TEST ###
library(ggrepel)
library(RColorBrewer)
# Define a color palette with enough colors for each unique appliance
palette <- brewer.pal(length(unique(data_purchase$appliance)),"Set1")
appliance_colors <- setNames(palette, unique(data_purchase$appliance))
### FUNNEL PLOT ###
funnel(
data_purchase$z_value,
v = data_purchase$z_variance,
# ylim = c(0, 0.3),
col = appliance_colors[as.factor(data_purchase$appliance)],
legend = FALSE # We'll create the legend manually
)
# Create the legend manually using the legend() function
legend("topright", # Position of the legend
legend = levels(as.factor(data_purchase$appliance)), # Legend labels
col = appliance_colors, # Legend colors
pch = 15, # Point type (change if needed)
title = "Appliance" # Legend title (change if needed)
)
### FUNNEL PLOT ###
funnel(
data_purchase$z_value,
v = data_purchase$z_variance,
# ylim = c(0, 0.3),
col = appliance_colors[as.factor(data_purchase$appliance)],
legend = FALSE # We'll create the legend manually
)
# Create the legend manually using the legend() function
legend("topright", # Position of the legend
legend = levels(as.factor(data_purchase$appliance)), # Legend labels
col = appliance_colors, # Legend colors
pch = 15, # Point type (change if needed)
title = "Appliance" # Legend title (change if needed)
)
dev.copy(jpeg,width=500,height=350,filename="eggers-funnel-appliance.jpg")
dev.off ()
palette <- brewer.pal(length(unique(data_purchase$intervention)[unique(data_purchase$intervention) != "Command & Control"]),"Set1")
intervention_colors <- setNames(palette,  unique(data_purchase$intervention)[unique(data_purchase$intervention) != "Command & Control"])
funnel(
data_purchase$z_value,
v = data_purchase$z_variance,
ylim = c(0, 0.3),
col = intervention_colors[as.factor(data_purchase$intervention)],
legend = FALSE # We'll create the legend manually
)
# Create the legend manually using the legend() function
legend("topright", # Position of the legend
legend = levels(as.factor(data_purchase$intervention))[levels(as.factor(data_purchase$intervention)) != "Command & Control"], # Legend labels
col = intervention_colors, # Legend colors
pch = 15, # Point type (change if needed)
title = "Intervention" # Legend title (change if needed)
)
dev.copy(jpeg,width=500,height=350,filename="eggers-funnel-intervention.jpg")
dev.off ()
data_purchase$se = (data_purchase$z_variance)^(1/2)
meta <-rma.mv(z_value, z_variance, # add all moderator variables
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase, method = "REML")
summary(meta)
meta_egger <-rma.mv(z_value, z_variance, mods =  ~ se, # add all moderator variables
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase, method = "REML")
summary(meta_egger)
meta_egger_1 <-rma.mv(z_value, z_variance, mods =  ~z_variance , # add all moderator variables
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase, method = "REML")
summary(meta_egger_1)
meta_egger1 <-rma.mv(z_value, z_variance, mods =  ~ intervention+se,
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase, method = "REML")
summary(meta_egger1)
meta_egger1_1 <-rma.mv(z_value, z_variance, mods =  ~ 0+intervention+se^2,
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase, method = "REML")
summary(meta_egger1_1)
meta_egger2_2 <-rma.mv(z_value, z_variance, mods =  ~ 0+appliance+se,
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase, method = "REML")
summary(meta_egger2_2)
# bias correction
meta_egger3 <-rma.mv(z_value, z_variance, mods =  ~ 0+intervention+z_variance,
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase, method = "REML")
summary(meta_egger3)
meta_egger4 <-rma.mv(z_value, z_variance, mods =  ~ 0+appliance+z_variance,
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase, method = "REML")
summary(meta_egger4)
#intervention model
threshold <- 0.1
x5 <- cooks.distance(meta_model5)
x5 <- cooks.distance(meta_model5)
plot(x5, type="l", pch=19, xlab="Observed Outcome", ylab="Cook's Distance")
for (i in 1:length(x5)) {
if (x5[i] > 0.1) {
text(i, x5[i], i, cex = 1, pos = 4, col = "red")
}
}
below_threshold_rows5 <- which(x5 < threshold)
data_purchase5 <- data_purchase[below_threshold_rows5,]
above_threshold_rows5 <- which(x5 > threshold)
outlier_cooksd5 <- data_purchase[above_threshold_rows5,]
# appliance model
threshold <- 0.5
x6 <- cooks.distance(meta_model6)
plot(x6, type="l", pch=19, xlab="Observed Outcome", ylab="Cook's Distance")
for (i in 1:length(x6)) {
if (x6[i] > threshold) {
text(i, x6[i], i, cex = 1, pos = 4, col = "red")
}
}
below_threshold_rows6 <- which(x6 < threshold)
data_purchase6 <- data_purchase[below_threshold_rows6,]
plot(x6, type="o", pch=19, xlab="Observed Outcome", ylab="Cook's Distance")
text(x6,labels=names(x6))
threshold <- 0.5
above_threshold_rows6 <- which(x6 > threshold)
outlier_cooksd6 <- data_purchase[above_threshold_rows6,]
### TESTING MODELS WITHOUT OUTLIERS ###
meta_model5_1 <-rma.mv(z_value, z_variance, mods =  ~ intervention+0+z_variance,
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase5, method = "REML")
summary(meta_model5_1)
meta_model6_1 <-rma.mv(z_value, z_variance, mods = ~ appliance + 0+z_variance,
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase6, method = "REML")
summary(meta_model6_1)
# both categories equally effective
data_purchase2 <- data_purchase %>%
filter(! sr_no %in% outlier_cooksd5$sr_no) %>%
filter(! sr_no %in% outlier_cooksd6$sr_no) %>%
#  filter(! intervention == "Loan") %>%
filter(appliance %in% c("Air-Conditioner", "Lighting","Refrigerator","Washing Machine"))
meta_model7 <-rma.mv(z_value, z_variance, mods =  ~ intervention_category:appliance+0,
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase2, method = "REML")
summary(meta_model7)
