levels(data_purchase$participant_type) <- gsub(" ", "_", levels(data_purchase$participant_type))
levels(data_purchase$reportingBiases) <- gsub(" ", "_", levels(data_purchase$reportingBiases))
levels(data_purchase$outOfSampleBias) <- gsub(" ", "_", levels(data_purchase$outOfSampleBias))
levels(data_purchase$study_design) <- gsub(" ", "_", levels(data_purchase$study_design))
data_purchase$participant_type1 <- relevel(data_purchase$participant_type, ref = "unspecified")
# data_purchase$intervention1 <- relevel(data_purchase$intervention, ref = "Rebate")
data_purchase$appliance1 <- relevel(data_purchase$appliance, ref = "Refrigerator")
data_purchase$publication_year_dummy <- ifelse(data_purchase$year_publication >= 2000, 1, 0)
# levels(data_purchase$intervention1)[levels(data_purchase$intervention1) %in% c("Information", "Label")] <- "Info"
topmod<- lm(z_value ~ z_variance+label+loan+rebate+subsidy+ appliance1+ incentive_follow_through+reportingBiases+
participant_type1+outOfSampleBias
,data = data_purchase)
plot(topmod, which = 4)
cooksD <- cooks.distance(topmod)
threshold <- 4/length(cooksD)
influential_obs <- which(cooksD > threshold)
data_purchase3 <- data_purchase[-influential_obs, ]
topmod1<- lm(z_value ~ z_variance+label+loan+rebate+subsidy+ appliance1+ incentive_follow_through+reportingBiases+
participant_type1+outOfSampleBias
,data = data_purchase3)
coeff_top<- coef_test(topmod1, vcov = "CR1", cluster = data_purchase3$study_ID, test = "naive-t")
coeff_top
write.table(coeff_top,"Fcheck.csv")
knitr::opts_chunk$set(echo = TRUE)
# meta_model5_3 <-rma.mv(z_value, z_variance, mods =  ~z_variance + study_design,
#                             random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase2, method = "REML")
# summary(meta_model5_3, digits = 2)
# Make sure study_design is a factor
# data_purchase2$study_design <- factor(
#   data_purchase2$study_design,
#   levels = c("control_&_treatment",
#              "DID",
#              "pre_and_post",
#              "quasi-experimental",
#              "simulated_counterfactual")
# )
study_designs <- levels(data_purchase2$study_design)
results <- list()
for (design in study_designs) {
cat("\nProcessing study_design =", design, "\n")
subset_data <- droplevels(subset(data_purchase2, study_design == design))
if (nrow(subset_data) > 1) {
meta_model <- tryCatch({
rma.mv(z_value, z_variance,
# mods = ~ z_variance,
random = ~ as.factor(sr_no) | as.factor(study_ID),
data = subset_data,
method = "REML")
}, error = function(e) {
cat("Error for", design, ":", e$message, "\n")
return(NULL)
})
if (!is.null(meta_model)) {
# Extract coefficient table
coef_table <- coef(summary(meta_model, digits = 2))
coef_df <- data.frame(
study_design = design,
k            = summary(meta_model)$k,
estimate     = coef_table[, "estimate"],
se           = coef_table[, "se"],
zval         = coef_table[, "zval"],
pval         = coef_table[, "pval"],
ci.lb        = coef_table[, "ci.lb"],
ci.ub        = coef_table[, "ci.ub"]
)
results[[design]] <- coef_df
}
}
}
# Combine all results into one tidy table
final_results <- bind_rows(results)
# Round numeric columns to 2 decimals
final_results <- final_results %>%
mutate(across(where(is.numeric), ~ round(.x, 2)))
print(final_results)
write.table(final_results,"Study_designsensitivity.csv")
