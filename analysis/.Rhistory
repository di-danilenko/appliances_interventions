### AVERAGE EFFECT PLOT ###
table(data_purchase$information)
table(data_purchase$label)
table(data_purchase$loan)
table(data_purchase$rebate)
table(data_purchase$subsidy)
coef_summary5 <- coef(summary(meta_model5))[c(1,2,3,4,5),]
rownames(coef_summary5) <- c("Information \n(n = 64)","Label \n(n = 109)","Loan \n(n = 12)","Rebate \n(n = 34)","Subsidy \n(n = 31)")
average_estimate5 <- coef(meta_model0)
ggplot(coef_summary5,
aes(x = row.names(coef_summary5), y = estimate)) +
geom_linerange(aes(ymin = ci.lb, ymax = ci.ub),
size = 1.5, alpha = 1, colour = "red")  +
geom_point(size = 3) +
geom_hline(yintercept = average_estimate5, linetype = "dashed", color = "black", size = .5) +
geom_hline(yintercept = 0, color = "gray", size = .5)+
annotate("text", x = 3.5, y = average_estimate5 - 0.025, label = paste("Average:", round(average_estimate5, 2)), size = 4.5) +
# scale_y_continuous(limits = c(-0.15, 0.35)) +
labs(x = "", y = "z-value") +
ylim(-.5, 0.5)+
theme_bw() +
theme(text = element_text(size = 20))
ggsave("interventions_forest.png")
coef_summary6 <- coef(summary(meta_model6))
rownames(coef_summary6) <- c("Air-Conditioner \n(n = 31)","Clothes Dryer \n(n = 6)","Dishwasher \n(n = 4)","Heat Pump \n(n = 18)","Lighting \n(n = 23)","Refrigerator \n(n = 54)","TV \n(n = 12)","Washing Machine \n(n = 13)","Water Heater \n(n = 43)")
average_estimate6 <- coef(meta_model0)
ggplot(coef_summary6,
aes(x = row.names(coef_summary6), y = estimate)) +
geom_linerange(aes(ymin = ci.lb, ymax = ci.ub),
size = 1.5, alpha = 1, colour = "red")  +
geom_point(size = 3) +
geom_hline(yintercept = average_estimate6, linetype = "dashed", color = "black", size = .5) +
geom_hline(yintercept = 0, color = "gray", size = .5)+
annotate("text", x = 6, y = average_estimate6 - 0.025, label = paste("Average:", round(average_estimate6, 2)), size = 4.5) +
# scale_y_continuous(limits = c(-0.15, 0.35)) +
labs(x = "", y = "z-value") +
ylim(-.5, 0.5)+
theme_bw() +
theme(text = element_text(size = 20)) + theme(axis.text.x = element_text(angle = 45, vjust = 1, hjust=1))
ggsave("appliances_forest.png")
