### PUBLICATION BIAS ASSESSMENT ###
library(lmtest)
### EGGERS TEST ###
funnel(data_purchase3$z_value,
v = data_purchase3$z_variance,
# level = c(90, 95, 99),
# shade = c("white", "gray55", "gray75"),
ylim = c(0, .3),
col = as.factor(data_purchase3$intervention),
legend =F)
funnel(data_purchase3$z_value,
v = data_purchase3$z_variance,
# level = c(90, 95, 99),
# shade = c("white", "gray55", "gray75"),
ylim = c(0, .3),
col = as.factor(data_purchase3$appliance),
legend =F)
data_purchase3$se = (data_purchase3$z_variance)^(1/2)
meta_egger1 <-rma.mv(z_value, z_variance, mods =  ~ intervention+se, # add all moderator variables
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase3, method = "REML")
summary(meta_egger1)
meta_egger2 <-rma.mv(z_value, z_variance, mods =  ~ appliance+se, # add all moderator variables
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase3, method = "REML")
summary(meta_egger2)
#
# # what does this do?
# robust(rma.mv(z_value, v, random = ~ as.factor(sr_no) | as.factor(study_ID),
#                      mods = ~ v, data = dfinc5, method = "REML"), cluster = as.factor(study_ID), clubSandwich = T)
# robust(rma(z_value, v,
#                      mods = ~ v, data = dfinc5, method = "FE"), cluster = study_ID, clubSandwich = T)
# bias correction
funnel(data_purchase3$z_value,
v = data_purchase3$z_variance,
# level = c(90, 95, 99),
# shade = c("white", "gray55", "gray75"),
ylim = c(0, .3),
col = as.factor(data_purchase3$appliance),
legend =T)
View(outlier_z_value)
# identify outliers
# outliers in loan and rebate (strong negative effects)
# outliers by variance (> 0.25)
# outliers by z_value > 0.5 or < - 0.5
threshold <- 0.2
x <- cooks.distance(meta_model3)
### PURCHASE PROBABILITY + WTP (incl. outliers)
### FIXED EFFECTS ###
meta_model1 <- rma(z_value, z_variance, data = data_purchase3, method = "FE", mods = ~ intervention+0)
# fixed effects by intervention
# all significant positive
meta_model2 <- rma(z_value, z_variance, data = data_purchase3, method = "FE", mods = ~ appliance+0)
# fixed effects by appliance
# AC, light, fridge, tv, washing machine, water heater significant positive
### RANDOM EFFECTS ###
meta_model3 <- rma(z_value, z_variance, data = data_purchase3, method = "REML", mods = ~ intervention+0)
# random effects by intervention
# information, label, rebate significant positive
meta_model4 <- rma(z_value, z_variance, data = data_purchase3, method = "REML", mods = ~ appliance+0)
# random effects by appliance
# AC, light, fridge, washing machine, water heater significant positive
### MULTI-LEVEL MODEL ###
meta_model0 <-rma.mv(z_value, z_variance, mods =  ~ dep_variable_purchase_category, # add all moderator variables
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase3, method = "REML")
meta_model0 <-rma.mv(z_value, z_variance, mods =  ~ intervention_category, # add all moderator variables
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase3, method = "REML")
#Above results show that there is no statistical difference between effect sizes for 1) wtp and purchase prob 2)monetary incentives and info strategies
meta_model5 <-rma.mv(z_value, z_variance, mods =  ~ intervention+0, # add all moderator variables
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase3, method = "REML")
summary(meta_model5)
meta_model5_1 <-rma.mv(z_value, z_variance, mods =  ~ intervention, # add all moderator variables
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase3, method = "REML")
summary(meta_model5_1)
# random effects multi-level by intervention
# information, label, rebate significant positive
meta_model6 <-rma.mv(z_value, z_variance, mods = ~ appliance,
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase3, method = "REML")
summary(meta_model6)
# random effects multi-level by appliance
# light, fridge, tv, washing machine significant positive
### INTERACTION INTERVENTION X APPLIANCE ###
data_purchase4 <- data_purchase3 %>%
filter(appliance %in% c("Refrigerator", "Lighting", "Washing Machine"))
meta_model7 <-rma.mv(z_value, z_variance, mods =  ~ intervention_category:appliance+0,
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase4, method = "REML")
# economic incentives x refrigerator have a negative sign
summary(meta_model7)
# run a model with control variables included
control_formula <- as.formula(paste("~", paste(controlvars, collapse = "+"), "+ 0"))
meta_model8 <-rma.mv(z_value, z_variance, mods = control_formula,
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase3, method = "REML")
# contrasts can be applied only to factors with 2 or more levels
# Iterate over variables in the dataset
for (var in controlvars) {
# Check the number of levels in each variable
num_levels <- nlevels(data_purchase3[[var]])
# Print the variable name if it has only one level
if (num_levels < 2) {
print(paste("Variable", var, "has only one level"))
}
}
# numeric and binary variables are causing errors
# effects don't change too much from inclusion of 'outliers'
# AC results change quite a bit, although there was only one effect size on AC
# Train papers show weird results for loan and z_values
# Skourtos paper has both high variance and z_value
summary(meta_model8)
# identify outliers
# outliers in loan and rebate (strong negative effects)
# outliers by variance (> 0.25)
# outliers by z_value > 0.5 or < - 0.5
threshold <- 0.2
x <- cooks.distance(meta_model3)
plot(x, type="o", pch=19, xlab="Observed Outcome", ylab="Cook's Distance")
text(x,labels=names(x))
above_threshold_rows <- which(x > threshold)
outlier_cooksd <- data_purchase3[above_threshold_rows,]
x4 <- cooks.distance(meta_model4)
View(outlier_cooksd)
plot(x4, type="o", pch=19, xlab="Observed Outcome", ylab="Cook's Distance")
text(x4,labels=names(x4))
above_threshold_rows4 <- which(x4 > threshold)
outlier_cooksd4 <- data_purchase3[above_threshold_rows4,]
