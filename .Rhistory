# Define a color palette with enough colors for each unique appliance
my_colors <- c("blue", "red", "green", "purple", "orange", "yellow", "pink", "brown", "gray")
# Create the plot
funnel(data_purchase3$z_value,
v = data_purchase3$z_variance,
ylim = c(0, .3),
col = my_colors[as.factor(data_purchase3$appliance)],
legend = FALSE)
# Get unique appliance values
unique_appliances <- unique(data_purchase3$appliance)
# Add the legend
legend("topright", legend = unique_appliances, col = my_colors[1:length(unique_appliances)], pch = 1)
data_purchase3_1 <- data_purchase3 %>%
filter(! sr_no %in% outlier_cooksd5)
meta_model5_1 <-rma.mv(z_value, z_variance, mods =  ~ intervention+0, # add all moderator variables
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase3_1, method = "REML")
summary(meta_model5_1)
ggplot(data_purchase3, aes(x = z_value, y = as.factor(outOfSampleBias))) +
geom_density_ridges2(fill = "lightblue", alpha = 0.5, scale = .8,
quantile_lines = TRUE, quantiles = c(0.5)) +
geom_jitter(height = .1, alpha = .1)
ggplot(data_purchase3, aes(x = z_value, y = as.factor(reportingBias))) +
geom_density_ridges2(fill = "lightblue", alpha = 0.5, scale = .8,
quantile_lines = TRUE, quantiles = c(0.5)) +
geom_jitter(height = .1, alpha = .1)
