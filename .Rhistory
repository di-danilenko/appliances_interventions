### PUBLICATION BIAS ASSESSMENT ###
library(lmtest)
### EGGERS TEST ###
# Define a color palette with enough colors for each unique appliance
my_colors <- c("blue", "red", "green", "purple", "orange", "yellow", "pink", "brown", "gray")
### FUNNEL PLOT ###
funnel(
data_purchase3$z_value,
v = data_purchase3$z_variance,
ylim = c(0, 0.3),
col = my_colors[as.factor(data_purchase3$appliance)],
legend = FALSE # We'll create the legend manually
)
# Create the legend manually using the legend() function
legend("topright", # Position of the legend
legend = levels(as.factor(data_purchase3$appliance)), # Legend labels
col = my_colors, # Legend colors
pch = 15, # Point type (change if needed)
title = "Appliance" # Legend title (change if needed)
)
funnel(
data_purchase3$z_value,
v = data_purchase3$z_variance,
ylim = c(0, 0.3),
col = my_colors[as.factor(data_purchase3$intervention_category)],
legend = FALSE # We'll create the legend manually
)
# Create the legend manually using the legend() function
legend("topright", # Position of the legend
legend = levels(as.factor(data_purchase3$intervention_category)), # Legend labels
col = my_colors, # Legend colors
pch = 15, # Point type (change if needed)
title = "Intervention" # Legend title (change if needed)
)
data_purchase3$se = (data_purchase3$z_variance)^(1/2)
meta <-rma.mv(z_value, z_variance, # add all moderator variables
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase3, method = "REML")
summary(meta)
meta_egger <-rma.mv(z_value, z_variance, mods =  ~ se, # add all moderator variables
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase3, method = "REML")
summary(meta_egger)
meta_egger_1 <-rma.mv(z_value, z_variance, mods =  ~z_variance , # add all moderator variables
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase3, method = "REML")
summary(meta_egger_1)
# meta_egger1 <-rma.mv(z_value, z_variance, mods =  ~ intervention+se, # add all moderator variables
#                                random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase3, method = "REML")
# summary(meta_egger1)
meta_egger1_1 <-rma.mv(z_value, z_variance, mods =  ~ 0+intervention+se^2, # add all moderator variables
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase3, method = "REML")
summary(meta_egger1_1)
# meta_egger2 <-rma.mv(z_value, z_variance, mods =  ~ appliance+se, # add all moderator variables
#                                random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase3, method = "REML")
# summary(meta_egger2)
meta_egger2_2 <-rma.mv(z_value, z_variance, mods =  ~ 0+appliance+se, # add all moderator variables
random = ~ as.factor(sr_no) | as.factor(study_ID), data = data_purchase3, method = "REML")
summary(meta_egger2_2)
